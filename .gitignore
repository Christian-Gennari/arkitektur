## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.
## Based on the standard Visual Studio .gitignore template.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx

# Benchmark results
BenchmarkDotNet.Artifacts/

# ReSharper and Rider
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# NuGet packages
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# NuGet package restore files
project.lock.json
project.fragment.lock.json

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Microsoft Azure Web App publish settings
PublishProfiles/
*.pubxml
*.publishproj

# Microsoft Azure build artifacts
csx/
.nuxt/

# Visual Studio web publish database cache
*.pdb

# SQL Server files
*.mdf
*.ldf

# Microsoft Azure Stream Analytics local run output
ASALocalRun/

# Local History for Visual Studio
.history/

# Generated documentation
*.generated.xml

# Cake build tool
/tools/

# dotnet CLI local tools
.dotnet/

# VS Code workspace history
.history

# OS files
.DS_Store
Thumbs.db
